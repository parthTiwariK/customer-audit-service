# Sample nginx front for customer-audit-service (adjust server_name and TLS).

upstream case_audit_app {
    server 127.0.0.1:8002;
    keepalive 8;
}

server {
    listen 80;
    server_name case-audit.example.com;

    gzip on;
    gzip_types text/html application/json text/css application/javascript;
    gzip_min_length 512;

    location /assets/ {
        proxy_pass http://case_audit_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://case_audit_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}